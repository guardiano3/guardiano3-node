{
  "name": "@guardiano3/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and JavaScript client for the GuardianO3 fraud-intelligence API.",
  "license": "Apache-2.0",
  "author": "Proneuronet Solutions Private Limited <support@guardiano3.com>",
  "homepage": "https://guardiano3.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guardiano3/guardiano3-node.git"
  },
  "bugs": {
    "url": "https://github.com/guardiano3/guardiano3-node/issues"
  },
  "keywords": [
    "guardiano3",
    "fraud",
    "scam",
    "api",
    "client",
    "sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "dist/generated",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/tests/*.test.js",
    "typecheck:samples": "node scripts/extract-samples.mjs && tsc -p tsconfig.samples.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
